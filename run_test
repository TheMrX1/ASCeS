#!/bin/bash
set -e

echo "Generating normal traffic (1200s)..."
python3 tools/traffic_gen.py normal 1200

echo "Generating anomaly traffic (600s)..."
python3 tools/traffic_gen.py anomaly 600

echo "Clearing old data..."
rm -f data/baselines/*.json data/asces.db

echo "Training Run 1..."
python3 -m asces.cli train --pcap normal.pcap

echo "Clearing old data..."
rm -f data/baselines/*.json data/asces.db

echo "Training Run 2..."
python3 -m asces.cli train --pcap normal.pcap

echo "Clearing old data..."
rm -f data/baselines/*.json data/asces.db

echo "Training Run 3..."
python3 -m asces.cli train --pcap normal.pcap

echo "Done. You can now run 'python3 -m asces.cli monitor --pcap anomaly.pcap'"
